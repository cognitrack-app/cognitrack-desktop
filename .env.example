# CogniTrack Desktop — Firebase Environment Variables
#
# Copy this file to .env and fill in the real values.
#
# How to get these values:
#   1. Go to https://console.firebase.google.com/project/cognitrack-dcede/settings/general
#   2. Under "Your apps" → select (or create) the Web app
#   3. Copy each value from the SDK config snippet shown there
#
# IMPORTANT: .env is gitignored. NEVER commit real API keys to version control.
# For CI/CD (GitHub Actions), set these as Repository Secrets and pass them
# to the build step via `env:` in the workflow file.

# From Firebase Console → Project Settings → General → Web app config
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=cognitrack-dcede.firebaseapp.com
FIREBASE_PROJECT_ID=cognitrack-dcede
FIREBASE_STORAGE_BUCKET=cognitrack-dcede.appspot.com
FIREBASE_MESSAGING_SENDER_ID=<numeric sender id from console>
FIREBASE_APP_ID=1:<sender_id>:web:<hash>
